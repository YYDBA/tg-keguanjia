# TG客管家 · 环境变量示例
# 复制为 .env（本地开发）或在 Vercel 项目设置中逐个添加

# Telegram bot token（@BotFather 创建后获得）
BOT_TOKEN=

# Supabase 项目信息（设置 → API Keys）
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# 服务端密钥：新版用 SUPABASE_SECRET_KEY（sb_secret_...，设置 → API Keys → Secret keys）。
# 旧版 SUPABASE_SERVICE_ROLE_KEY（eyJ...）仍兼容，但官方将于 2026 年底删除旧密钥，建议用新名。
SUPABASE_SECRET_KEY=

# 管理员 telegram_id（能生成兑换码的人）。
# 获取方法：私聊 @userinfobot 或 @getmyid_bot，它会返回你的数字 id。
# OWNER_ID=123456789

# 部署后你的 Vercel 域名（用于设置 webhook）
# WEBHOOK_DOMAIN=https://your-app.vercel.app
